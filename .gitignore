# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Local provider/plugin cache and working dirs
**/.terraform/
.terraform.tfstate.lock.info

# State files — NEVER commit. State lives in S3 (kong-refresher-tfstate).
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Saved plans and the pipeline's plan output
tfplan
*.tfplan
plan.txt

# Variable files may contain secrets (e.g. konnect_pat). Commit only *.example.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local CLI overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# KEEP the dependency lock file committed — it pins provider versions for
# reproducible plans/applies. It is intentionally NOT ignored:
# .terraform.lock.hcl   <-- leave this tracked

# ---------------------------------------------------------------------------
# Secrets / credentials (belt-and-suspenders — none of these belong in git)
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials
aws-credentials*

# ---------------------------------------------------------------------------
# OAS -> Terraform generation (generate.sh). The OAS is the source of truth;
# the generated Kong config is a CI build artifact and is NOT committed.
# ---------------------------------------------------------------------------
konnect/apigw/build/
**/generated_gateway.tf
konnect/apigw/terraform/**/build/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local-only, never for the public mirror (ssbhadauria/kong-deployments)
# ---------------------------------------------------------------------------
# Continue.dev IDE agent configs (personal, machine-local)
.continue/
# Local data-plane cert material and lab scratch (contains private keys)
enterprise/
**/helm/.certs/
